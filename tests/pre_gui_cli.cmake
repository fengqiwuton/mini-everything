# 在独立根布置足够的新增文件，让 1 ms 批处理限时在提交前触发并保留旧索引。
set(cancel_root "${TEST_DIR}/cancel-${run_id}")
set(cancel_db "${TEST_DIR}/cancel-${run_id}.db")
file(MAKE_DIRECTORY "${cancel_root}")
file(WRITE "${cancel_root}/keep.txt" "old")
run_ok(output scan "${cancel_root}" --db "${cancel_db}")
foreach(number RANGE 1 500)
    file(WRITE "${cancel_root}/added-${number}.txt" "new")
endforeach()
run_cancelled(output scan "${cancel_root}" --db "${cancel_db}" --incremental --timeout-ms 1 --format json)
if(NOT output STREQUAL "")
    message(FATAL_ERROR "cancelled scan reported an uncommitted result: ${output}")
endif()
run_ok(output stats --db "${cancel_db}" --format json)
string(JSON files GET "${output}" files)
string(JSON bytes GET "${output}" bytes)
if(NOT files EQUAL 1 OR NOT bytes EQUAL 3)
    message(FATAL_ERROR "cancelled incremental scan changed the committed index")
endif()

# 以 -- 开头的文件名和选项值是字面文本，不能被误认为缺少位置参数或值。
file(WRITE "${cancel_root}/--literal.txt" "literal")
file(WRITE "${cancel_root}/suffix.--txt" "literal extension")
run_ok(output scan "${cancel_root}" --db "${cancel_db}" --incremental)
run_ok(output search --literal.txt --db "${cancel_db}" --mode exact --format json)
string(JSON name GET "${output}" 0 name)
if(NOT name STREQUAL "--literal.txt")
    message(FATAL_ERROR "leading -- literal search text changed")
endif()
run_ok(output search suffix --db "${cancel_db}" --ext --txt --format json)
string(JSON name GET "${output}" 0 name)
if(NOT name STREQUAL "suffix.--txt")
    message(FATAL_ERROR "leading -- literal extension changed")
endif()
