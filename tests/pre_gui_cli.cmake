# 执行预期成功的 CLI 命令，把 stdout 返回到调用者变量，失败时显示错误诊断。
function(run_ok variable)
    execute_process(COMMAND "${APP}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "command failed (${code}): ${ARGN}\n${output}\n${error}")
    endif()
    set(${variable} "${output}" PARENT_SCOPE)
endfunction()

# 执行预期参数错误的命令，验证不合法输入没有被默默接受。
function(run_invalid)
    execute_process(COMMAND "${APP}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT code EQUAL 2)
        message(FATAL_ERROR "expected usage error: ${ARGN}\n${code} ${output} ${error}")
    endif()
endfunction()

# 取消命令必须返回 130，stdout 中只能包含取消前已成功提交的结构化结果。
function(run_cancelled variable)
    execute_process(COMMAND "${APP}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT code EQUAL 130 OR NOT error MATCHES "Cancelled:")
        message(FATAL_ERROR "expected cancellation: ${ARGN}\n${code} ${output} ${error}")
    endif()
    set(${variable} "${output}" PARENT_SCOPE)
endfunction()

